{
  "name": "shift-launcher",
  "productName": "Shift Launcher",
  "version": "0.1.0",
  "description": "Лёгкий лаунчер Minecraft без рекламы и телеметрии: моды из Modrinth и CurseForge",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/copy-font.js && electron .",
    "test": "node test/run.js && node test/ui-smoke.js",
    "dist": "node scripts/copy-font.js && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@fontsource-variable/inter": "^5.1.0"
  },
  "build": {
    "appId": "local.cubic.launcher",
    "productName": "Shift Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ShiftLauncher-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ShiftLauncher-Portable-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}